{
  "name": "@asa1984/configs",
  "version": "0.2.0",
  "description": "asa1984's configurations",
  "license": "MIT",
  "author": "asa1984 <me@asa1984.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asa1984/configs.git"
  },
  "files": [
    "dist",
    "src/tsconfig"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint/index.d.ts",
      "default": "./dist/oxlint/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt/index.d.ts",
      "default": "./dist/oxfmt/index.js"
    },
    "./tsconfig": "./src/tsconfig/base.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm generate && tsgo -p tsconfig.build.json",
    "format": "oxfmt",
    "generate": "node scripts/generate.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsgo"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.2",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "@vitest/eslint-plugin": "1.6.20",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "63.0.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unicorn": "64.0.0",
    "eslint-typegen": "2.3.1",
    "jsr": "0.14.3",
    "oxfmt": "0.53.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "0.23.0",
    "rulesync": "8.24.1"
  },
  "peerDependencies": {
    "oxfmt": ">=0.51.0",
    "oxlint": ">=1.66.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.5.2"
}
