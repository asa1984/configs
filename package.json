{
  "name": "@asa1984/configs",
  "version": "0.2.0",
  "description": "asa1984's configurations",
  "license": "MIT",
  "author": "asa1984 <me@asa1984.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asa1984/configs.git"
  },
  "files": [
    "dist",
    "src/tsconfig"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint/index.d.ts",
      "default": "./dist/oxlint/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt/index.d.ts",
      "default": "./dist/oxfmt/index.js"
    },
    "./vite-plus": {
      "types": "./dist/vite-plus/index.d.ts",
      "default": "./dist/vite-plus/index.js"
    },
    "./tsconfig": "./src/tsconfig/base.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "generate": "node scripts/generate.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.5",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/eslint-plugin": "1.6.20",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "63.0.14",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unicorn": "64.0.0",
    "eslint-typegen": "2.3.1",
    "jsr": "0.14.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "rulesync": "8.32.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-plus": "0.3.0"
  },
  "peerDependencies": {
    "oxfmt": ">=0.51.0",
    "oxlint": ">=1.66.0",
    "vite-plus": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.23.0"
}
